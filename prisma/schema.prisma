// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
 provider = "prisma-client"
 output   = "./generated/prisma"
binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"  
}

model Products {
  id  Int    @id @default(autoincrement())
  name  String
  description  String?
  category  Categories    @relation(fields: [categoryId], references: [id])
  categoryId  Int
  brand  Brands    @relation(fields: [brandId], references: [id])
  brandId  Int
  recommendation Recommendation?
  imgUrls  ProductsImgUrls[]
  variants ProductVariants[]
  cartItems  CartItems[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Recommendation {
  id  Int    @id @default(autoincrement())
  product  Products @relation(fields: [productId], references: [id])
  productId Int @unique
  status Boolean
}

model ProductVariants {
  id  Int    @id @default(autoincrement())
  product   Products? @relation(fields: [productId], references: [id])
  productId Int?
  color String
  stock Int @default(0)
  price  Float
  prevPrice  Float @default(0)
  tag String
}

model Categories {
  id  Int @id @default(autoincrement())
  name  String @unique
  imgUrl CategoriesImgUrls?
  products  Products[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brands {
  id  Int @id @default(autoincrement())
  name  String @unique
  imgUrl BrandsImgUrls? 
  products  Products[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItems {
  id  Int @id @default(autoincrement())
  user   Users? @relation(fields: [userId], references: [id])
  userId Int? 
  sessionCart String
  product   Products? @relation(fields: [productId], references: [id])
  productId Int
  variantId Int
  quantity Int
  price Float
  subtotal Float
  comment String?
  active Boolean @default(true)
  ordered  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Users {
  id    Int    @id @default(autoincrement())
  email  String @unique
  phone String
  avatar String @default("https://res.cloudinary.com/dts7qcxky/image/upload/c_fill,g_face,h_40,w_40/logo-w-kregu-z-kotem-w-kapeluszu-i-okularach-ilustracja-sztuki-wektorowej_1249528-76_nyqmkg")
  role  String @default("user")
  active Boolean @default(false)
  cartItems CartItems[]
  password String
  //password Auth?
  address UsersAddresses[]
  account Account[]
  session Session[]
  orders Orders[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model paymentMethods {
  id    Int    @id @default(autoincrement())
  name String
  type String
  imgUrl  String
  orders Orders[]
}

model Auth {
  id    Int    @id @default(autoincrement())
  password  String
//  user   Users @relation(fields: [userId], references: [id])
//  userId Int @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsersAddresses{
  id    Int    @id @default(autoincrement())
  name  String
  user   Users @relation(fields: [userId], references: [id])
  main Boolean @default(false)
  userId Int
  address String
  country String
  province String
  city String
  zip Int
  orders Orders[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model shippingMethods {
  id    Int    @id @default(autoincrement())
  name String
  imgUrl String
  price Float
  orders Orders[]
}
model Orders {
  id    Int    @id @default(autoincrement())
  user   Users @relation(fields: [userId], references: [id])
  userId Int
  address   UsersAddresses? @relation(fields: [addressId], references: [id])
  addressId Int?
  orderedProducts orderedProduct[]
  shippingMethod   shippingMethods? @relation(fields: [shippingMethodId], references: [id])
  shippingMethodId Int?
  paymentStatus String?
  promoCode String? 
  paymentMethod   paymentMethods? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int?
  totalPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model orderedProduct {
  id Int    @id @default(autoincrement())
  order   Orders @relation(fields: [orderId], references: [id])
  orderId Int
  productId Int
  productName String
  variantId Int
  img String
  quantity Int
  price Float
  color String?
  brand String?
  category String?
  protection Boolean @default(false)
  comment  String?
}

model CategoriesImgUrls {
    id    Int    @id @default(autoincrement())
    url String
    category  Categories @relation(fields: [categoryId], references: [id])
    categoryId Int @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
model BrandsImgUrls {
    id    Int    @id @default(autoincrement())
    url String
    brand   Brands @relation(fields: [brandId], references: [id])
    brandId Int @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
model ProductsImgUrls {
    id    Int    @id @default(autoincrement())
    url String 
    tag String 
    main Boolean
    product   Products? @relation(fields: [productId], references: [id])
    productId Int?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
model SlideShow {
  id    Int    @id @default(autoincrement())
  title String
  category String
  description String
  imgUrl String
}

//=====================================================================next auth start

model Account {
  id                 Int  @id @default(autoincrement())
  userId             Int  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])

}
 
model Session {
  sessionToken String   @id
  userId       Int   @map("user_id")
  expires      DateTime
  user         Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])

}
//=====================================================================next authnext auth end














